# Cloned repos (downloaded by build.sh or repo sync)
build/
# Exception: top-level BUILD.bazel makes //build a Bazel package (needed by msm_platforms.bzl)
!build/BUILD.bazel
external/
kernel/
msm-kernel/
tools/bazel
tools/mkbootimg/
vendor/
out/
dist/

# Prebuilts downloaded at build time
# clang binaries are downloaded — track only the Bazel toolchain rules (kleaf/)
prebuilts/clang/host/linux-x86/clang-*/
prebuilts/gcc/
prebuilts/jdk/
prebuilts/ndk-r23/
prebuilts/kernel-build-tools/
# Binaries populated by kernel-build-tools repo into build-tools
prebuilts/build-tools/BUILD.bazel
prebuilts/build-tools/common/
prebuilts/build-tools/path/
prebuilts/build-tools/linux-x86/bin/bison
prebuilts/build-tools/linux-x86/bin/cxx_extractor
prebuilts/build-tools/linux-x86/bin/flex
prebuilts/build-tools/linux-x86/bin/m4
prebuilts/build-tools/linux-x86/bin/make
prebuilts/build-tools/linux-x86/bin/openssl
prebuilts/build-tools/linux-x86/bin/runextractor
prebuilts/build-tools/linux-x86/bin/ziptool

# Bazel symlinks and cache
bazel-*
.bazel/

# Bazel auto-generated MODULE files
MODULE.bazel
MODULE.bazel.lock

# Build logs
*.log

# User-specific bazelrc (generated by build.sh with absolute cache_dir path)
.bazelrc.user

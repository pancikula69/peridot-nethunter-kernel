# Kleaf flag aliases (--user_kmi_symbol_lists, --lto, etc.)
try-import %workspace%/build/kernel/kleaf/bazelrc/flags.bazelrc
# Platform configs (--config=android_arm64, etc.)
try-import %workspace%/build/kernel/kleaf/bazelrc/platforms.bazelrc
# Local build config (--config=local disables hermetic sandbox, uses host tools)
try-import %workspace%/build/kernel/kleaf/bazelrc/local.bazelrc
# Disable bzlmod (android14-era Kleaf uses WORKSPACE)
common --noenable_bzlmod
# Use host system tools directly (skip hermetic GCC sysroot sandbox).
# The kernel is compiled by clang; the hermetic sysroot is only for host helpers.
build --config=local
# Enable proper CC toolchain resolution via register_toolchains() (Kleaf clang toolchain).
# Without this flag Bazel uses legacy resolution and picks @local_config_cc (GCC).
build --incompatible_enable_cc_toolchain_resolution
# FACTORY_BUILD is referenced via ctx.var in kernel_config.bzl; define it here.
build --define=FACTORY_BUILD=0
# hermetic_tools tar/rsync wrapper scripts call 'realpath' from the hermetic PATH.
# Disable sandboxing for these actions so host system tools are accessible.
build --strategy=HermeticToolsTar=local
build --strategy=HermeticToolsRsync=local
build --strategy=HermeticTools=local
# GkiArtifacts uses cp -l (hard links) to collect kernel images.
# Hard links across the linux-sandbox tmpfs boundary fail with EXDEV.
# Run locally so source and dest share the same filesystem.
build --strategy=GkiArtifacts=local
# SignBootImg (avbtool add_hash_footer) opens boot.img for read+write.
# The file is a hard-linked Bazel artifact (read-only); sandbox makes
# the open fail with EACCES. Run locally where Bazel output tree
# permissions are available.
build --strategy=SignBootImg=local
# No-op alias: build_with_bazel.py passes --ignore_missing_projects which is
# normally consumed by kleaf/bazel.py. Define it as a bool_flag in //:
build --flag_alias=ignore_missing_projects=//:ignore_missing_projects
# User-specific settings (absolute paths) — generated by build.sh, not committed.
# Contains: build --//build/kernel/kleaf:cache_dir=<absolute-out-path>
try-import %workspace%/.bazelrc.user
